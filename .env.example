# Copy to .env.local for local development. On Vercel, add the same names
# under Project → Settings → Environment Variables.
# Placeholders only — never commit real values.

# --- Supabase (reviews, submissions, users) ---
# Project URL, from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" key, safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key: server only, full database access. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Cloudflare Turnstile (spam check on forms) ---
# Site key, shown in the browser. The widget's allowed hostnames must include
# your live domain, or every form fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# Secret key, used server-side to verify the check
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# --- Mailchimp (newsletter sign-ups) ---
# API key, includes the data-centre suffix (e.g. ...-us21)
MAILCHIMP_API_KEY=your_mailchimp_api_key
# Audience (list) ID the sign-ups go into
MAILCHIMP_AUDIENCE_ID=your_mailchimp_audience_id

# --- Admin (local only) ---
# /admin returns 404 outside `npm run dev`, so this is not needed on Vercel.
ADMIN_PASSWORD=your_secure_admin_password_here
